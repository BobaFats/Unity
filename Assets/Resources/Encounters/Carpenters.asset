  choices:
  - label: "\u041F\u043E\u043C\u043E\u0447\u044C"
    resultText: "\u0412 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C \u043F\u043B\u043E\u0442\u043D\u0438\u043A\u0438 \u0441\u043A\u043E\u043B\u043E\u0442\u044F\u0442 \u0432\u0430\u043C \u0431\u0430\u0448\u043D\u044E-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0430."
