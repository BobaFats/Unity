    horseshoeCost: 0
  - label: "\u041D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438"
    resultText: "\u041C\u043E\u0441\u0442 \u0441\u043A\u0440\u0438\u043F\u0438\u0442, \u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442."
