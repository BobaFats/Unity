  m_Script: {fileID: 11500000, guid: 3c7bbe52cc6cbfd4ea3d248210b740ea, type: 3}
  m_Name: CarlsonJumpsuit
  m_EditorClassIdentifier: Assembly-CSharp::Tanks2D.QuestDefinition
  _id: 
  title: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u041A\u0430\u0440\u043B\u0441\u043E\u043D\u0430"
  description: "\u0416\u0438\u0442\u0435\u043B\u0438 \u0421\u0442\u0430\u0440\u043E\u0433\u043E \u0421\u0430\u0440\u0430\u044F \u0438\u0449\u0443\u0442 \u0420\u043E\u043C\u0443 \u043F\u043E \u043F\u0440\u0438\u043C\u0435\u0442\u0430\u043C \u0438 \u043E\u0434\u0435\u0436\u0434\u0435. \u0420\u043E\u043C\u0430 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043E\u0434\u0435\u0436\u0434\u043E\u0439 \u0441 \u0442\u043E\u0440\u0433\u0430\u0448\u043E\u043C \u041D\u043E\u0432\u043E\u0433\u043E \u0421\u0430\u0440\u0430\u044F \u2014 \u0438 \u0432\u043C\u0435\u0441\u0442\u043E \u0420\u043E\u043C\u044B \u043F\u043E\u0445\u0438\u0449\u0430\u044E\u0442 \u0442\u043E\u0440\u0433\u0430\u0448\u0430."
  town: {fileID: 11400000, guid: 3fa750ad8b5c41344bf5808112efe234, type: 2}
  buildingId: market
  requiredFlags: []
  blockingFlags: []
  giverNpcId: 
  giverName: "\u0422\u043E\u0440\u0433\u0430\u0448"
  giverPortrait: {fileID: 0}
  giverColor: {r: 0.9, g: 0.62, b: 0.3, a: 1}
  lines:
  - kind: 1
    speaker: 
    portrait: 2
    text: "\u0418\u0437-\u0437\u0430 \u0442\u043E\u0433\u043E \u0447\u0442\u043E \u0420\u043E\u043C\u0430 \u043D\u0430\u043F\u043E\u0440\u0442\u0430\u0447\u0438\u043B \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u0437\u0430\u0434\u0430\u043D\u0438\u0438, \u0436\u0438\u0442\u0435\u043B\u0438 \u0421\u0442\u0430\u0440\u043E\u0433\u043E \u0421\u0430\u0440\u0430\u044F \u0438\u0449\u0443\u0442 \u0420\u043E\u043C\u0443 \u043F\u043E \u0432\u0441\u0435\u0439 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u2014 \u0432\u043F\u043B\u043E\u0442\u044C \u0434\u043E \u041D\u043E\u0432\u043E\u0433\u043E \u0421\u0430\u0440\u0430\u044F."
    rightSide: 0
    portraitSprite: {fileID: 0}
  - kind: 1
    speaker: 
    portrait: 2
    text: "\u0422\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0432 \u041D\u043E\u0432\u043E\u043C \u0421\u0430\u0440\u0430\u0435..."
    rightSide: 0
    portraitSprite: {fileID: 0}
  - kind: 0
    speaker: "\u0422\u043E\u0440\u0433\u0430\u0448"
    portrait: 28
    text: "<i>(\u0441 \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u043C)</i> \u041E\u0433\u043E, \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0435\u0431\u0435, \u043A\u0430\u043A\u0430\u044F \u0443 \u0432\u0430\u0441 \u043E\u0434\u0435\u0436\u0434\u0430, \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u0442!"
    rightSide: 0
    portraitSprite: {fileID: 0}
  - kind: 0
    speaker: "\u0420\u043E\u043C\u0430"
    portrait: 2
    text: "\u041D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u0434\u0430? \u041E\u0431\u043C\u0435\u043D\u044F\u044E \u043D\u0430 \u0442\u0432\u043E\u0439 \u043E\u0431\u043E\u0441\u0440\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D."
    rightSide: 1
    portraitSprite: {fileID: 0}
  - kind: 0
    speaker: "\u0422\u043E\u0440\u0433\u0430\u0448"
    portrait: 28
    text: "<i>(\u0432 \u043C\u044B\u0441\u043B\u044F\u0445: \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0435\u0431\u0435 \u0443\u0434\u0430\u0447\u0430!)</i>\n\u0421\u044D\u0440, \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u0432\u0430\u0448\u0435\u0439 \u0434\u043E\u043F\u043B\u0430\u0442\u043E\u0439. \u042D\u0442\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0441\u0430\u043C\u043E\u0433\u043E... \u042D\u044D\u044D\u044D... \u041A\u0430\u0440\u043B\u0441\u043E\u043D\u0430! \u0414\u0430, \u041A\u0430\u0440\u043B\u0441\u043E\u043D\u0430!"
    rightSide: 0
    portraitSprite: {fileID: 0}
  - kind: 0
    speaker: "\u0420\u043E\u043C\u0430"
    portrait: 2
    text: "\u041B\u0430\u0434\u043D\u043E, \u043F\u043E \u0440\u0443\u043A\u0430\u043C."
    rightSide: 1
    portraitSprite: {fileID: 0}
  - kind: 1
    speaker: 
    portrait: 2
    text: "\u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u043E\u0431\u043C\u0435\u043D.\n\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u0435\u0440\u0435\u043E\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044F."
    rightSide: 0
    portraitSprite: {fileID: 0}
  - kind: 1
    speaker: 
    portrait: 2
    text: "\u0421\u043F\u0443\u0441\u0442\u044F 2 \u0447\u0430\u0441\u0430..."
    rightSide: 0
    portraitSprite: {fileID: 0}
  - kind: 1
    speaker: 
    portrait: 2
    text: "\u0420\u0430\u0437\u0433\u043D\u0435\u0432\u0430\u043D\u043D\u044B\u0435 \u0436\u0438\u0442\u0435\u043B\u0438 \u0421\u0442\u0430\u0440\u043E\u0433\u043E \u0421\u0430\u0440\u0430\u044F \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E\u0442 \u0434\u0443\u0440\u043D\u043E \u043F\u0430\u0445\u043D\u0443\u0449\u0435\u0433\u043E \u0444\u0435\u0440\u043C\u0435\u0440\u0430 \u043F\u043E \u043F\u0440\u0438\u043C\u0435\u0442\u0430\u043C \u0438 \u043E\u0434\u0435\u0436\u0434\u0435 \u0420\u043E\u043C\u044B."
    rightSide: 0
    portraitSprite: {fileID: 0}
  - kind: 0
    speaker: "\u0416\u0438\u0442\u0435\u043B\u044C \u0421\u0442\u0430\u0440\u043E\u0433\u043E \u0421\u0430\u0440\u0430\u044F"
    portrait: 28
    text: "\u0424\u0443\u0443\u0443, \u043D\u0443 \u0438 \u0432\u043E\u043D\u0438\u0449\u0435! \u0422\u044B \u0447\u0442\u043E, \u043E\u0431\u043E\u0441\u0440\u0430\u043B\u0441\u044F?"
    rightSide: 0
    portraitSprite: {fileID: 0}
  - kind: 0
    speaker: "\u041F\u0435\u0440\u0435\u043E\u0434\u0435\u0442\u044B\u0439 \u0420\u043E\u043C\u0430"
    portrait: 2
    text: "\u0414\u0432\u0430\u0436\u0434\u044B. \u041F\u0430\u0440\u0435\u043D\u044C, \u043F\u0440\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u044B \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0435, \u0431\u0440\u043E\u0434\u0438\u0442 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435."
    rightSide: 1
    portraitSprite: {fileID: 0}
  - kind: 1
    speaker: 
    portrait: 2
    text: "\u0417\u0430\u043D\u0430\u0432\u0435\u0441.\n\u0422\u043E\u0440\u0433\u043E\u0432\u0446\u0430 \u043F\u043E\u0445\u0438\u0449\u0430\u044E\u0442 \u0440\u0430\u0437\u0431\u0443\u0448\u0435\u0432\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u0436\u0438\u0442\u0435\u043B\u0438."
    rightSide: 0
    portraitSprite: {fileID: 0}
  resultText: "\u041F\u043E\u0433\u043E\u043D\u044F \u0441\u0431\u0438\u0442\u0430 \u0441\u043E \u0441\u043B\u0435\u0434\u0430: \u0432\u043C\u0435\u0441\u0442\u043E \u0420\u043E\u043C\u044B \u0443\u0432\u0435\u043B\u0438 \u0442\u043E\u0440\u0433\u0430\u0448\u0430."
  setFlags:
  - torgash_kidnapped
  - roma_in_jumpsuit
  clearFlags: []
  effects: []
